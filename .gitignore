# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# ...except AWS's RDS CA bundle, which is a *public* trust store: 111 root
# certificates and no private key, published at truststore.pki.rds.amazonaws.com.
# It has to be tracked, because the Dockerfile bakes it in — and a build that
# fetched it instead would depend on AWS being reachable from CI. See
# docs/deployment.md for how to refresh it.
!certs/rds-global-bundle.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Message exports for the lab. Real personal data: never commit these, wherever
# they are dropped. LAB_TRANSCRIPT_CSV should point outside the repo entirely.
*.imessages.csv
/transcripts/

# Bundled worker, sweep and migration entrypoints. Built into the image.
/dist/
